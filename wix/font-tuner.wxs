<?xml version="1.0" encoding="utf-8"?>
<!--
  Font-tuner installer. Self-contained: ships font-tuner.exe, the RenderCore64 core
  DLL built from source, and the rendering profiles. Registers Font-tuner to run
  at logon, stops the closed-source MacTray if it is running, and starts it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Font-tuner"
           Manufacturer="zero-platform-Lab"
           Version="$(var.Version)"
           UpgradeCode="7d0f6c3e-2f0c-4c1b-9b0e-5a1d2c3b4e5f"
           Language="1041"
           Codepage="65001"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="新しい版の Font-tuner がすでに入っている。" />

    <!-- RenderCore64.dll (and RenderBootstrap64.dll) is injected into every process on the machine, so it
         is always "in use" by the user's terminal, shell, editor, etc.  With the
         Restart Manager enabled, msiexec would close ALL of those to replace the
         DLL - it has killed the user's PowerShell / Claude Code session more
         than once.  Disable it: in-use files are swapped on next reboot instead,
         and only the tray itself is closed (util:CloseApplication below). -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Font-tuner">
        <Directory Id="ProfilesFolder" Name="ini" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Main" Directory="INSTALLFOLDER">
      <Component Id="AppExe">
        <File Id="AppExeFile" Source="$(var.StageDir)\font-tuner.exe" KeyPath="yes">
          <!-- Start menu entry, so the tray can be launched by hand after
               "Exit" without digging into Program Files. -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Font-tuner"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
        </File>
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Font-tuner"
                       Value="&quot;[INSTALLFOLDER]font-tuner.exe&quot;"
                       Type="string" />
      </Component>
      <Component Id="CoreDll">
        <File Id="RenderCore64.dll" Source="$(var.StageDir)\RenderCore64.dll" />
        <!-- Renamed-away cores from RenameOldCore (below). Freed ones go now;
             ones still mapped by running processes are scheduled by MSI for
             deletion at the next reboot. -->
        <RemoveFile Id="OldCores" Name="RenderCore64.dll.old.*" On="install" />
      </Component>
      <Component Id="BootstrapDll">
        <!-- Child-process loader stub the core injects into every process it
             spawns (expfunc.cpp GdippInjectDLL). Rust replacement for the
             closed-source upstream bootstrap. Reaches ordinary child processes
             (e.g. Chrome's crashpad-handler / utility processes); it does NOT
             reach Chrome/Edge renderer & GPU processes, which block unsigned
             DLLs via MITIGATION_FORCE_MS_SIGNED_BINS. -->
        <File Id="RenderBootstrap64.dll" Source="$(var.StageDir)\RenderBootstrap64.dll" />
      </Component>
      <Component Id="MainIni" NeverOverwrite="yes" Permanent="no">
        <!-- User-edited; never clobbered on upgrade. -->
        <File Id="FontTunerIni" Source="$(var.StageDir)\font-tuner.ini" />
      </Component>
    </ComponentGroup>

    <!-- ini\*.ini harvested at build time by build-msi.ps1. -->
    <ComponentGroup Id="Profiles" Directory="ProfilesFolder">
      <Files Include="$(var.StageDir)\ini\*.ini" />
    </ComponentGroup>

    <Feature Id="Main" Title="Font-tuner" Level="1">
      <ComponentGroupRef Id="Main" />
      <ComponentGroupRef Id="Profiles" />
    </Feature>

    <!-- Stop both trays before files are touched. -->
    <util:CloseApplication Id="CloseMacTray" Target="MacTray.exe"     CloseMessage="no" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseApp"     Target="font-tuner.exe"  CloseMessage="no" TerminateProcess="0" RebootPrompt="no" />

    <!-- RenderCore64.dll is mapped into every running GUI process and keeps
         itself loaded until each of them exits, so the file is never free to
         overwrite. Instead of MSI's fallback (leave the old file, swap on
         reboot - new processes keep getting the OLD core until then), rename
         the in-use file out of the way first: Windows allows renaming a mapped
         image. InstallFiles then finds the name free and the freshly started
         tray hooks with the new core immediately. Must run before the old
         product's RemoveFiles (RemoveExistingProducts), or that would queue a
         reboot-time delete against the name the new file is about to take. -->
    <SetProperty Id="RenameOldCore"
                 Value="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;[INSTALLFOLDER]RenderCore64.dll&quot; ren &quot;[INSTALLFOLDER]RenderCore64.dll&quot; RenderCore64.dll.old.%RANDOM%%RANDOM%"
                 Before="RenameOldCore" Sequence="execute" />
    <CustomAction Id="RenameOldCore"
                  DllEntry="WixQuietExec64"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Start Font-tuner when the install finishes. -->
    <CustomAction Id="LaunchApp"
                  FileRef="AppExeFile"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="RenameOldCore" Before="RemoveExistingProducts" Condition="NOT REMOVE" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed OR UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
